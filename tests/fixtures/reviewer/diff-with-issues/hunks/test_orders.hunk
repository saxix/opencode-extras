+
+
+def test_gross_amount_without_a_known_country_adds_no_tax():
+    order = {"net_amount": Decimal("100.00"), "country": "XX"}
+    assert gross_amount(order) == Decimal("100.00")
+
+
+def test_gross_amount_is_quantized_to_cents():
+    order = {"net_amount": Decimal("10.01"), "country": "DE"}
+    gross = gross_amount(order)
+    assert gross == Decimal("11.91")
+    assert gross.as_tuple().exponent == -2
+
+
+def test_gross_amount_rounds_half_up():
+    order = {"net_amount": Decimal("0.005"), "country": "XX"}
+    assert gross_amount(order) == Decimal("0.01")
+
+
+def test_gross_amount_rejects_a_float_amount():
+    with pytest.raises(TypeError):
+        gross_amount({"net_amount": 100.0, "country": "IT"})
