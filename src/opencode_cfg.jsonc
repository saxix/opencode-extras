{
  "$schema": "https://opencode.ai/config.json",
  "small_model": "ollama/qwen2.5-coder:3b",
  "default_agent": "plan",
  "subagent_depth": 2,
  "share": "manual",
  "shell": "bash",
  "plugin": [
    "opencode-gemini-auth@latest"
  ],
  "watcher": {
    "ignore": [
      "node_modules/**",
      "dist/**",
      ".git/**",
      ".idea/**",
      ".tox/**",
      ".venv/**"
    ]
  },
//  "mcp": {
//    "azure-devops": {
//      "type": "local",
//      "command": ["uv", "run", "mcp-ticketing", "azure"],
//      "cwd": "{env:MCP_TICKETING_HOME}",
//      "enabled": false
//    },
//    "github": {
//      "type": "local",
//      "command": ["uv", "run", "mcp-ticketing", "github"],
//      "cwd": "{env:MCP_TICKETING_HOME}",
//      "enabled": true
//    }
//  },
  "instructions": [
    ".ai/*.md"
  ],
  "tools": {
  },
  "attachment": {
    "image": {
      "auto_resize": true,
      "max_width": 1000,
      "max_height": 1000,
      "max_base64_bytes": 5242880
    }
  },
  "permission": {

  },
  "provider": {
    "dwarfstar": {
      "name": "ds4.c (local)",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://127.0.0.1:9999/v1",
        "apiKey": "dsv4-local"
      },
      "models": {
        "deepseek-v4-flash": {
          // Massive 384k output capacity for batch generation and heavy background agent loops.
          "name": "ds4 / DeepSeek V4 Flash (9/10)",
          "limit": {
            "context": 5000000,
            "output": 384000
          }
        }
      }
    },
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "ollama",
      "options": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": {
        "qwen3.6:27b": {
          "name": "ollama / Qwen 3.6 27B (Local High-Quant)",
          "tool_call": true,
          "limit": {
            "context": 32768,
            "output": 8192
          },
          "options": {
            "num_ctx": 32768,
            "keep_alive": "10m"
          }
        },
        "qwen3-coder:30b": {
          // Exceptional local multi-file editing, tool use, and Python/Django refactoring.
          "name": "ollama / coding / qwen3-coder:30b (9.22/10)",
          "tool_call": true,
          "limit": {
            "context": 65536,
            "output": 32768
          },
          "options": {
            "num_ctx": 65536,
            "keep_alive": 0
          }
        },
        "devstral:24b": {
          // Best-in-class for git diff resolution, shell automation, and repo searching.
          "name": "ollama / coding / devstral 24B (8.8/10)",
          "tool_call": true,
          "limit": {
            "context": 65536,
            "output": 32768
          },
          "options": {
            "num_ctx": 65536,
            "keep_alive": 0
          }
        },
        "richardyoung/qwable-9b-abliterated:Q8_0": {
          "name": "ollama / Qwable 9b",
          "tool_call": false,
          "limit": {
            "context": 65536,
            "output": 32768
          },
          "options": {
            "num_ctx": 65536,
            "keep_alive": 0
          }
        },
        "deepseek-r1:32b": {
          // Top-tier native step-by-step reasoning (Chain-of-Thought) for complex logic bugs.
          "name": "ollama / reasoning / DeepSeek R1 32B (Reasoning)",
          "tool_call": false,
          "limit": {
            "context": 65536,
            "output": 32768
          },
          "options": {
            "num_ctx": 65536,
            "keep_alive": 0
          }
        },
        // used as small_model
        "qwen2.5-coder:3b": {
          "name": "ollama / qwen2.5 (coder)",
          "limit": {
            "context": 65536,
            "output": 32768
          },
          "options": {
            "num_ctx": 65536,
            "keep_alive": 0
          }
        },
        "qwen3-coder:latest": {
          "name": "ollama / qwen3-coder:latest (upstream)",
          "limit": {
            "context": 65536,
            "output": 32768
          },
          "options": {
            "num_ctx": 65536,
            "keep_alive": 0
          }
        }
      }
    },
    "google": {
      "name": "Google Gemini",
      "models": {
        "gemini-3.1-pro-preview": {
          "name": "Gemini 3.1 Pro",
          "limit": {
            "context": 1048576,
            "output": 65536
          }
        },
        "gemini-3.7-flash": {
          "name": "Gemini 3.7 Flash",
          "limit": {
            "context": 1048576,
            "output": 65536
          }
        },
        "gemini-3.6-flash": {
          "name": "Gemini 3.6 Flash",
          "limit": {
            "context": 1048576,
            "output": 65536
          }
        }
      }
    }
  },
  "agent": {
  },
  "command": {
  },
  "formatter": {
    "ruff": {
      "command": [
        "ruff",
        "format",
        "$FILE"
      ],
      "extensions": [
        ".py"
      ]
    }
  }
}
